# Copy to .env, fill in, then: set -a; source .env; set +a

# Required by `boxagent run`. Google AI Studio API key.
GEMINI_API_KEY=

# Optional. The values below are the defaults.
# BOXAGENT_MODEL=gemini-3.5-flash-lite
# BOXAGENT_DATA_DIR=$HOME/.boxagent
# BOXAGENT_IMAGE=golang:1.23-bookworm
# BOXAGENT_MAX_TURNS=25
# BOXAGENT_LOG_LEVEL=info
